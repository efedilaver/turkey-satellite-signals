# .env olarak kopyalayıp doldur. .env git'e girmez ve asla commit edilmemelidir.

# Google Earth Engine bulut proje kimliği (ticari olmayan ücretsiz kayıt: https://earthengine.google.com)
GEE_PROJECT=gee-proje-kimligin

# EPİAŞ Şeffaflık Platformu hesabı (https://seffaflik.epias.com.tr); src/collect/epias_*.py kullanır
EPTR_USERNAME=epias-kullanici-adin
EPTR_PASSWORD=epias-sifren

# TCMB EVDS API anahtarı (https://evds3.tcmb.gov.tr); yalnız makro seriler için
EVDS_API_KEY=evds-api-anahtarin

# Yalnız bilanço sürprizi çalışmaları: ayrı İş Yatırım / KAP veri setinin klasörü
# (repoda yok; betikler ortam değişkenini okur, bu yüzden `export RESEARCH_DIR=...`)
RESEARCH_DIR=../Research
